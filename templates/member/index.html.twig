{% extends 'base.html.twig' %}

{% block title %}Membres{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Membres</h1>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for member in members %}
                <tr>
                    <td>{{ member.id }}</td>
                    <td>{{ member.email }}</td>
                    <td>
                        <a href="{{ path('app_member_show', {'id': member.id}) }}"
                           class="btn btn-sm btn-primary">Voir</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Aucun membre trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

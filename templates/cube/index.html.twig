{% extends 'base.html.twig' %}

{% block title %}Cube index{% endblock %}

{% block body %}
    <h1>Cube index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cube in cubes %}
            <tr>
                <td>{{ cube.id }}</td>
                <td>{{ cube.description }}</td>
                <td>
                    <a href="{{ path('app_cube_show', {'id': cube.id}) }}">show</a>
                    <a href="{{ path('app_cube_edit', {'id': cube.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cube_new') }}">Create new</a>
{% endblock %}

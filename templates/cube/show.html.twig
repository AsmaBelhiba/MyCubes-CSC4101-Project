{% extends 'base.html.twig' %}

{% block title %}Cube{% endblock %}

{% block body %}
    <h1>Cube</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cube.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ cube.description }}</td>
            </tr>
        </tbody>
    </table>
    
    
    {% if cube.imageName %}
    	<div>
        	<h3>Image du cube</h3>
        	<img src="{{ vich_uploader_asset(cube, 'imageFile') }}"
            	 alt="{{ cube.description }}"
             	style="max-width: 300px; height: auto;">
    	</div>
    {% endif %}
    

    <a href="{{ path('app_cube_index') }}">back to list</a>

    <a href="{{ path('app_cube_edit', {'id': cube.id}) }}">edit</a>

    {{ include('cube/_delete_form.html.twig') }}
{% endblock %}

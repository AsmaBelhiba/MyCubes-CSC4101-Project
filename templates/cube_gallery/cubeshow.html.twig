{% extends 'base.html.twig' %}

{% block title %}Cube n°{{ cube.id }}{% endblock %}

{% block body %}

    <h1>Cube</h1>

    {% dump cube %}
    
    
{% if app.user
    and cube_gallery.publiee
    and cube_gallery.member.id != app.user.id
    and cube not in app.user.favoriteCubes %}

    <form method="post"
          action="{{ path('app_favorite_add', {'id': cube.id}) }}">

        <input type="hidden"
               name="_token"
               value="{{ csrf_token('favorite_add' ~ cube.id) }}">

        <button type="submit">
            ❤️ Add to Favorites
        </button>
    </form>

{% endif %}
    

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cube.id }}</td>
            </tr>

            <tr>
                <th>Description</th>
                <td>{{ cube.description }}</td>
            </tr>
        </tbody>
    </table>

	<a href="{{ path('app_cube_gallery_show', {'id': cube_gallery.id}) }}">
    	Retour à la galerie
	</a>

{% endblock %}
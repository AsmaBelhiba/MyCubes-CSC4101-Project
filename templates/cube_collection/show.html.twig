{% extends 'base.html.twig' %}
{% block title %}Collection de cubes{% endblock %}

{% block body %}
    <h1>Collection de cubes #{{ cube_collection.id }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ cube_collection.id }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ cube_collection.description }}</td>
            </tr>
        </tbody>
    </table>
	
	<a href="{{ path('app_cube_new', {'id': cube_collection.id}) }}">Ajouter un cube</a>
    <a href="{{ path('app_member_show', {'id': cube_collection.member.id}) }}">Retour au membre</a>
{% endblock %}

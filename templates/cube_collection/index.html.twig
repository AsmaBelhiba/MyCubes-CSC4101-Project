
{% extends 'base.html.twig' %}

{% block title %}Cube Collections{% endblock %}

{% block body %}
    <div class="container px-4 px-lg-5 mt-5">
        <h1>Cube Collections</h1>

        <ul>
            {% for cubeCollection in cubeCollections %}
                <li>
                    <a href="{{ path('cube_collection_show', {'id': cubeCollection.id}) }}">
                        {{ cubeCollection.description }}
                    </a>
                </li>
            {% else %}
                <li>Aucune collection disponible.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}CubeCollection index{% endblock %}

{% block body %}
    <h1>CubeCollection index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for cube_collection in cube_collections %}
            <tr>
                <td>{{ cube_collection.id }}</td>
                <td>{{ cube_collection.description }}</td>
                <td>
                    <a href="{{ path('app_cube_collection_show', {'id': cube_collection.id}) }}">show</a>
                    <a href="{{ path('app_cube_collection_edit', {'id': cube_collection.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_cube_collection_new') }}">Create new</a>
{% endblock %}


{% extends 'base.html.twig' %}

{% block title %}Cube Collections | myCubes{% endblock %}

{% block body %}

    <div class="mb-4">
        <div class="text-muted small mb-2">
            COLLECTIONS / ALL COLLECTIONS
        </div>

        <h1>Cube Collections</h1>

        <p class="text-muted">
            Browse the cube collections of our members.
        </p>
    </div>

    <div class="cube-list">

        {% for cube_collection in cube_collections %}

            <div class="cube-item">

                <div class="cube-details">

                    
					<div class="cube-name">
                        {{ cube_collection.description
                            | replace({
            				'Collection de ': '',
            				'@localhost': ''
                            })
                            | capitalize
                        }}'s Cube Collection
					</div>

<div class="cube-id">
    COLLECTION #{{ cube_collection.id }}
</div>
                    

                    <div class="cube-actions">
                        <a href="{{ path('app_cube_collection_show', {'id': cube_collection.id}) }}">
                            View collection
                        </a>
                    </div>

                </div>

            </div>

        {% else %}

            <p>No collections found.</p>

        {% endfor %}

    </div>

{% endblock %}
